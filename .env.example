# ═══════════════════════════════════════════════
# BRASIL RD ADDON - Configuração de Ambiente
# ═══════════════════════════════════════════════
# Copie este arquivo para .env e preencha com seus dados
# cp .env.example .env

# ── Torbox / Real-Debrid ─────────────────────
# Obtenha sua API key em: https://torbox.app/dashboard
TORBOX_API_KEY=sua_api_key_aqui
# Chave opcional usada pelo catálogo de magnets curados
TORBOX_CURATOR_API_KEY=

# ── TMDB (The Movie Database) ────────────────
# Obtenha sua API key em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_tmdb_api_key_aqui
# Fallback opcional para títulos/metadados IMDb
OMDB_API_KEY=

# ── Aplicação ────────────────────────────────
NODE_ENV=development
PORT=7000
# Nome do addon mostrado no player/manifesto (ex.: brasilrd-vercel)
ADDON_NAME=Brasil RD

# ── URLs dos indexadores/scrapers ─────────────────
# Altere somente quando o domínio padrão mudar ou houver mirror próprio.
BLUDV_BASE_URL=https://bludvfilmes1.xyz
HDR_BASE_URL=https://hdrtorrents.net
STARCK_BASE_URL=https://www.starck-oficial.com
WORDPRESS_COMANDO_URL=https://comando1.com
WORDPRESS_STARCK_URL=https://www.starck-oficial.com
WORDPRESS_DARKMAHOU_URL=https://darkmahou.io
# Código órfão/opcional; não é chamado pelo fluxo principal atual.
RARGB_BASE_URL=https://rargb.to
TPB_MIRRORS=https://www4.thepiratebay3.co,https://piratebay.live,https://1.piratebays.to,https://tpb.party
TORRENT_INDEXER_URL=https://torrent-indexer.darklyn.org
# URL base da API Betor (catálogo BR)
BETOR_SEARCH_URL=https://search.betor.top

# Scrapers (false/off/0 desativa; padrão true)
SCRAPER_BLUDV_ENABLED=true
SCRAPER_WORDPRESS_ENABLED=true
SCRAPER_STARCK_ENABLED=true
SCRAPER_HDR_ENABLED=true
# Fonte HTTP alternativa para resultados BLUDV quando a raspagem direta
# estiver bloqueada pelo WAF. Usa o endpoint público do torrent-indexer.
SCRAPER_TORRENT_INDEXER_ENABLED=true
# API Betor — catálogo de torrents BR, busca por imdb_id ou título
SCRAPER_BETOR_ENABLED=true

# Modo P2P (false/off/0 oculta o toggle da UI e remove do manifest)
P2P_ENABLED=true

# ── Banco de Dados (PostgreSQL) ──────────────
# Desenvolvimento local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brasil_rd_addon?sslmode=disable
# Produção (Railway ou similar):
# DATABASE_URL=postgresql://user:password@host:port/database
# Alternativas aceitas quando DATABASE_URL não existir:
# POSTGRES_URL=postgresql://user:password@host:port/database?sslmode=require
# DATABASE_PUBLIC_URL=postgresql://user:password@host:port/database?sslmode=require
# RAILWAY_POSTGRES_URL=postgresql://user:password@host:port/database

# SSL para conexão externa ao banco
DB_SSL=true

# ── SSL Local (HTTPS no localhost) ───────────
# Gere certificados autoassinados:
# openssl req -x509 -newkey rsa:2048 -keyout localhost.key -out localhost.crt -days 365 -nodes -subj "/CN=localhost"
SSL_PRIVATE_KEY=localhost.key
SSL_CERTIFICATE=localhost.crt

# ── Logging ──────────────────────────────────
# Opções: debug, info, warn, error
LOG_LEVEL=info

# ── Cache ────────────────────────────────────
CACHE_TTL=86400

# ── Cloudflare Tunnel (opcional) ─────────────
# Token permanente do túnel Cloudflare para dev
# Obtenha em: https://one.dash.cloudflare.com/ -> Access -> Tunnels
# CLOUDFLARED_TOKEN=seu_token_cloudflare_aqui

# ── URL Base Pública ─────────────────────────
# URL pública onde o addon está hospedado (usada para gerar URLs nos streams)
# Em produção, pode ser seu domínio ou URL do Railway
BASE_URL=http://localhost:7000

# ── Proxy (opcional) ─────────────────────────
# Usado APENAS na raspagem dos indexadores. A reprodução (Torbox/P2P) é
# sempre direct play — o addon não serve o vídeo.
# Formatos: http://host:port, https://host:port, socks5://user:senha@host:port
# Ex.: PROXY_URL=socks5://user:senha@192.0.2.10:1080
# PROXY_URL=http://localhost:8118

# ── Criptografia/configuração ──────────────────
# Chaves usadas pelas rotas /e/:token e configuração protegida.
ENCRYPTION_KEY=
CONFIG_SECRET=

# ── Torznab / compatibilidade Prowlarr ─────────
TORZNAB_API_KEY=

# ── Comportamento de persistência ──────────────
# true desativa escritas no banco (útil em Vercel/testes)
SKIP_DB_WRITE=false

# ── Railway/URLs de runtime ────────────────────
RAILWAY_STATIC_URL=
RAILWAY_POSTGRES_URL=

# ── Addons externos ────────────────────────────────
# URLs de manifest.json de addons Stremio-compatíveis para agregar streams.
# Separe por vírgula. Os streams são retornados sem re-validação de título.
# Ex.: EXTERNAL_ADDON_MANIFESTS=https://addon1.example.com/manifest.json,https://addon2.example.com/manifest.json
# EXTERNAL_ADDON_MANIFESTS=
