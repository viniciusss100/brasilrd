{
  "name": "brasil-rd-addon",
  "version": "1.5.1",
  "description": "Addon brasileiro para Stremio com suporte completo ao Real-Debrid",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "node build.js",
    "deploy": "node scripts/deploy-release.js",
    "start": "node railway-start.js",
    "start:stremio": "node dist/server.js",
    "dev": "node scripts/dev.js",
    "dev:tunnel": "node scripts/dev-tunnel.js",
    "dev:stremio": "ts-node src/server.ts",
    "dev:local": "npx cross-env PORT=7001 LOG_LEVEL=info node dist/server.js",
    "test": "jest",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "add-magnet": "npx tsx scripts/add-magnet.ts",
    "migrate": "node scripts/migrate-database.js",
    "migrate:dev": "node scripts/migrate-database.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cacheable": "^2.3.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "fs-extra": "^11.3.2",
    "parse-torrent": "^11.0.24",
    "pg": "^8.16.3",
    "prom-client": "^14.2.0",
    "request-ip": "^3.3.0",
    "sequelize": "^6.37.8",
    "stremio-addon-sdk": "^1.6.10",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "tunnel": "^0.0.6",
    "typescript": "^5.0.0",
    "ua-parser-js": "^2.0.6"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/request-ip": "^0.0.41",
    "@types/stremio-addon-sdk": "^1.6.12",
    "@types/tunnel": "^0.0.7",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "jest": "^29.0.0",
    "tsx": "^4.23.1"
  },
  "keywords": [
    "stremio",
    "addon",
    "real-debrid",
    "brasil",
    "streaming",
    "content"
  ],
  "author": "ONIKO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brasil-rd/brasil-rd-addon"
  },
  "bugs": {
    "url": "https://github.com/brasil-rd/brasil-rd-addon/issues"
  },
  "homepage": "https://github.com/brasil-rd/brasil-rd-addon#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
